# Puerto donde escucha el servidor
PORT=3000

# Entorno de ejecución: development | production
NODE_ENV=development

# Orígenes permitidos por CORS.
# Usa "*" para permitir cualquiera (solo recomendable en desarrollo),
# o una lista separada por comas: https://miapp.com,https://www.miapp.com
CORS_ORIGIN=*
